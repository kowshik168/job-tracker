generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ResumeType {
  BACKEND_SDE
  SRE_DEVOPS
  GENERAL_SWE
  OTHER
}

enum Source {
  LINKEDIN
  COMPANY_WEBSITE
  REFERRAL
  WELLFOUND
  NAUKRI
  INSTAHYRE
  OTHER
}

enum ApplicationStatus {
  SAVED
  APPLIED
  OA
  RECRUITER_SCREEN
  INTERVIEW
  OFFER
  REJECTED
  ON_HOLD
}

enum CurrentRound {
  NONE
  OA
  RECRUITER_SCREEN
  TECHNICAL_ROUND_1
  TECHNICAL_ROUND_2
  SYSTEM_DESIGN
  MANAGERIAL
  HR
  FINAL
  OTHER
}

model Application {
  id               String            @id @default(cuid())
  company          String
  role             String
  jobUrl           String?
  appliedAt        DateTime
  source           Source?
  referral         String?
  resumeType       ResumeType
  resumeId         String?
  resume           Resume?           @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  status           ApplicationStatus @default(SAVED)
  currentRound     CurrentRound      @default(NONE)
  recruiterName    String?
  recruiterContact String?
  followUpDate     DateTime?
  notes            String?
  learnings        ResumeLearning[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status])
  @@index([appliedAt])
  @@index([followUpDate])
  @@index([company])
  @@index([resumeId])
  @@map("applications")
}

model Resume {
  id           String           @id @default(cuid())
  name         String
  resumeType   ResumeType
  fileName     String
  mimeType     String
  fileSize     Int
  data         Bytes
  notes        String?
  applications Application[]
  learnings    ResumeLearning[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("resumes")
}

model ResumeLearning {
  id             String        @id @default(cuid())
  content        String
  resumeId       String
  resume         Resume        @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  applicationId  String?
  application    Application?  @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@index([resumeId])
  @@map("resume_learnings")
}
