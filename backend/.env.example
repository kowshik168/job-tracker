DATABASE_URL="postgresql://postgres:postgres@localhost:5432/job_tracker?schema=public"
PORT=3001
CORS_ORIGIN="http://localhost:5173"

# Auth — set a strong password before deploying
ADMIN_PASSWORD="change-me-to-a-strong-password"
JWT_SECRET="change-me-to-a-random-secret-at-least-32-chars"

# Optional: use bcrypt hash instead of plain password (recommended for production)
# Generate with: node -e "require('bcrypt').hash('your-password', 10).then(console.log)"
# ADMIN_PASSWORD_HASH=""
